{
  "name": "situation-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LED-style situation room clock formatted for iPads",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:js": "vite build",
    "build:html": "eleventy",
    "build": "npm run build:js && npm run build:html",
    "watch": "vite build --watch",
    "test": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/situation-clock.git"
  },
  "author": "Ben Balter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/benbalter/situation-clock/issues"
  },
  "homepage": "https://github.com/benbalter/situation-clock#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@eslint/js": "10.0.1",
    "eslint": "^10.0.0",
    "globals": "17.13.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "browserslist": [
    "defaults"
  ]
}
